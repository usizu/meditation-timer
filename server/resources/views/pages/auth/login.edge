@layout.main({ title: 'Sign in — Kitty Timer' })
	@slot('main')
		<h1>Sign in</h1>

		@if(flashMessages.has('error'))
			<div class="error">{{ flashMessages.get('error') }}</div>
		@end

		<form method="POST" action="{{ route('auth.send') }}">
			{{ csrfField() }}

			<div class="form-group">
				<label for="email">Email address</label>
				<input
					type="email"
					id="email"
					name="email"
					placeholder="you@example.com"
					required
					autofocus
				>
			</div>

			<button type="submit">Send login code</button>
		</form>

		<p class="hint">We'll email you a 6-digit code to sign in.</p>
	@end
@end
